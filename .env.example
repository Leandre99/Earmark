# Copy to .env and fill in. Never commit .env.

# Postgres connection string, e.g. a free Neon database (https://neon.tech).
# The same database can be used locally and on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app's business account acts as the platform that holds funds until invoices are verified.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Invoices at or below this amount (USD) that pass every check are paid without asking the sender.
AUTO_APPROVE_LIMIT_USD="200"
